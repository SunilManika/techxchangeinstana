# =============================================================================
# inputs.env — Configuration for Instana application perspective creation
# =============================================================================
# 1. Fill in ALL required values below.
# 2. Save the file.
# 3. Run:
#      Python : python3 create_application.py
#      Shell  : bash create_application.sh
#
# The script uses INSTANA_TOKEN to create a temporary full-permission token
# for this lab run, creates the application perspective, then deletes it.
# =============================================================================

# Your Instana tenant base URL (no trailing slash)
# Example: https://mytenant.instana.io  OR  https://instana.mycompany.com
INSTANA_URL="https://unit0-techzone.150-240-162-27.nip.io"

# Admin API token — get it from: Instana UI → Profile (top-right) → API Tokens
# Enable at minimum: "Configuration of applications" and "Configuration of API tokens"
INSTANA_TOKEN="Fn3Jc9GeTZyudAU4nHfDNg"

# ---------------------------------------------------------------------------
# Application perspective settings
# ---------------------------------------------------------------------------

# Display name for the new application perspective
APP_NAME="Retail_App_Sunil"

# One or more tag-based rules that define which services belong to this app.
# Format: a semicolon-separated list of  key=value  pairs.
# Each pair becomes one tag-match rule (operator: EQUALS).
# Example (single tag) : APP_TAGS="service.name=checkout"
# Example (multi  tags) : APP_TAGS="kubernetes.namespace.name=production;service.name=frontend"
APP_TAGS="kubernetes.namespace.name=techxchange"

# ---------------------------------------------------------------------------
# Advanced settings (defaults are correct for most labs — change only if needed)
# ---------------------------------------------------------------------------

# Boundary scope: which calls to include.
# ALL              → all calls (default)
# INBOUND          → only inbound calls
BOUNDARY_SCOPE="ALL"
