# ──────────────────────────────────────────────────────────────────────────────
# Instana User Invite — environment variables
# ──────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values in .env
# 3. Load on Linux/macOS:  source .env
#    Load on PowerShell:   Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of your Instana instance (no trailing slash, no path fragment)
# Self-hosted example:  https://unit0-techzone.150-240-162-27.nip.io
# SaaS example:         https://myunit-mytenant.instana.io
INSTANA_BASE_URL=https://<unit>.<host>

# API token — must have "Configuration of users" (canConfigureUsers) permission
INSTANA_API_TOKEN=<your-api-token>
